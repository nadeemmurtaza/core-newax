# Copy to scripts/backup.env (gitignored) and source before running
# scripts/backup-postgres.sh:  set -a; . scripts/backup.env; set +a

PG_CONTAINER=n8n-postgres
PG_DB=n8n
PG_USER=n8n
RETENTION_DAYS=14
BACKUP_LOCAL_DIR=/opt/newax/backups/postgres

# RustFS (staging copy) - same values as scripts/rustfs.env
RUSTFS_ENDPOINT=http://10.0.5.5:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_REGION=us-east-1
RUSTFS_BACKUP_BUCKET=newax-backups

# ---------------------------------------------------------------------------
# OFFSITE target - REQUIRED for real disaster recovery. Leave blank to skip.
# Any S3-compatible provider off this VPS: Backblaze B2, Wasabi, AWS S3, ...
# ---------------------------------------------------------------------------
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
BACKUP_OFFSITE_REGION=us-east-1
