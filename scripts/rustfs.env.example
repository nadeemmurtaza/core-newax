# Copy to scripts/rustfs.env and fill in. scripts/rustfs.env is gitignored.
# Source it before running the RustFS helper scripts:  set -a; . scripts/rustfs.env; set +a

# S3 endpoint for RustFS. From the host, the container is reachable on the
# n8n-internal docker network; from inside that network use http://rustfs:9000
RUSTFS_ENDPOINT=http://10.0.5.5:9000

# RustFS root / service credentials (see docker-compose.yml env on the host)
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# RustFS accepts any region label; keep it stable.
RUSTFS_REGION=us-east-1
