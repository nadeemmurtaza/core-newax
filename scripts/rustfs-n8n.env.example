# Scoped RustFS credential for n8n (STORAGE_* workflows), NOT the root key.
# Copy to scripts/rustfs-n8n.env and fill in (gitignored). This is a
# reference for what's set on n8n's "S3 account" credential (id
# UOBSnxPxyEhgyZQH) — n8n itself holds the live copy; this file is just so
# the credential is reproducible/rotatable from the host without walking the
# RustFS console.
#
# IAM user: n8n-storage-service
# Policy:   n8n-storage-service (created via scripts/rustfs-admin.py or the
#           RustFS console on :9001 — see docs/DATABASE_HARDENING.md's
#           companion note in docs/STATUS.md item 4)
# Scope:    read/write/list on newax-images, newax-videos, newax-documents,
#           newax-temp. Deliberately EXCLUDES newax-backups — that bucket is
#           written by scripts/backup-postgres.sh using the root key, not n8n.

RUSTFS_ENDPOINT=http://10.0.5.5:9000
RUSTFS_ACCESS_KEY=n8n-storage-service
RUSTFS_SECRET_KEY=
RUSTFS_REGION=us-east-1
