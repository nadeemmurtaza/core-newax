{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetObjectVersion",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::newax-images",
        "arn:aws:s3:::newax-images/*",
        "arn:aws:s3:::newax-videos",
        "arn:aws:s3:::newax-videos/*",
        "arn:aws:s3:::newax-documents",
        "arn:aws:s3:::newax-documents/*",
        "arn:aws:s3:::newax-temp",
        "arn:aws:s3:::newax-temp/*"
      ]
    }
  ]
}
