{
  "name": "newax-core",
  "version": "0.0.0",
  "private": true,
  "description": "Private monorepo foundation for reusable NEWAX business infrastructure.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "pnpm -r --if-present run clean",
    "database-registry:generate": "node tooling/database-registry/generate.mjs --mode snapshot --output docs/generated/database-registry --write",
    "database-registry:test": "node --test tooling/database-registry/generate.test.mjs",
    "dev": "pnpm -r --parallel --if-present run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "learning:analyze": "node tooling/analyze-root-cause.mjs",
    "learning:flush": "node tooling/flush-engineering-events.mjs",
    "learning:graph": "node tooling/analyze-error-graph.mjs",
    "learning:ingest": "node tooling/ingest-engineering-event.mjs",
    "learning:receive": "node tooling/engineering-event-receiver.mjs",
    "learning:record": "node tooling/record-engineering-event.mjs",
    "learning:run": "node tooling/run-engineering-command.mjs --",
    "learning:verify-explanation": "node tooling/analyze-explanation.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "operation:validate": "node tooling/validate-operation-intent.mjs",
    "prepare": "husky",
    "test": "pnpm test:learning && turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:learning": "node --test tooling/engineering-event-upgrade.test.mjs tooling/engineering-explanation-integration.test.mjs tooling/engineering-issue-error-graph.test.mjs tooling/engineering-learning-core.test.mjs tooling/error-relationship-graph.test.mjs tooling/explanation-evidence-github.test.mjs tooling/explanation-verification.test.mjs tooling/external-failure-intake.test.mjs tooling/root-cause-engine.test.mjs tooling/workflow-failure-intake-controls.test.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "node tooling/run-engineering-command.mjs -- pnpm verify:raw",
    "verify:raw": "pnpm format:check && pnpm verify:workflow-intake && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:workflow-intake": "node tooling/workflow-failure-intake-controls.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "knip": "6.29.0",
    "lint-staged": "17.2.0",
    "prettier": "3.9.0",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": "prettier --write"
  }
}
