{
  "name": "@newaxhq/charts",
  "version": "1.1.0",
  "description": "Reusable charting for NEWAX applications: Line/Bar/Area/Pie/Scatter/Sparkline, shared chart containers (header/legend/footer/loading/error/empty states), and number/date formatters. Built on recharts rather than reimplementing chart math/SVG/interaction from scratch; themed from @newaxhq/design-system's chart palette, not a second colour system.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nadeemmurtaza/core-newax.git",
    "directory": "packages/charts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@newaxhq/ui": "workspace:*",
    "recharts": "3.10.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "4.1.10",
    "react": "19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
