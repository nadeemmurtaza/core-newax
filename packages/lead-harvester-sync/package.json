{
  "name": "@newax/lead-harvester-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrates syncing Harvester lead data into the Central Registry via CoreExternalReference mappings.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "VERSION"
  ],
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@newax/addresses": "workspace:*",
    "@newax/contacts": "workspace:*",
    "@newax/external-references": "workspace:*",
    "@newax/memberships": "workspace:*",
    "@newax/organizations": "workspace:*",
    "@newax/people": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
