{
  "name": "@newaxhq/ui",
  "version": "1.1.1",
  "description": "The canonical NEWAX UI component library: actions/controls, form components, feedback/status, overlays, content/data display, data presentation, consent/legal notices, and layout/accessibility primitives. Built on the design-system tokens package; brand values stay in each app's own brand.ts.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nadeemmurtaza/core-newax.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "react": "19.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
