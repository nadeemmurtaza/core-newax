{
  "name": "@newaxhq/dashboard-ui",
  "version": "1.0.0",
  "description": "Dashboard shell components: widget container, grid shell, and the standard loading/empty/access-denied/error render states from @newaxhq/dashboard-contracts. Renders structure only -- each widget's actual content comes from the owning service.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nadeemmurtaza/core-newax.git",
    "directory": "packages/dashboard-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@newaxhq/dashboard-contracts": "workspace:*",
    "@newaxhq/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "react": "19.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
